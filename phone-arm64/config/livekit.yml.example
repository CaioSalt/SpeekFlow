rtc:
  # use_external_ip=true: descobre o IP publico via STUN a cada start.
  # NAO usar node_ip explicito: no Android/proot o livekit morre com
  # "route ip+net: netlinkrib: invalid argument" antes de subir (visto apos
  # reboot em nov/2026, aplica-se a 1.13.4).
  use_external_ip: true
  port_range_start: 50000
  port_range_end: 50100
  tcp_port: 7881

redis:
  address: 127.0.0.1:6379

turn:
  enabled: false

keys:
  <node-key>: <node-secret>

webhook:
  api_key: <node-key>
  urls:
  - "http://127.0.0.1:8500/worldwide"
