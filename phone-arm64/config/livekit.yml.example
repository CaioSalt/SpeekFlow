rtc:
  # Banco de candidatos ICE anunciados ao LiveKit.
  # use_external_ip=true: STUN falha 100% da vez neste provedor ("context canceled")
  # e o IPv4 publico NUNCA entra na lista de candidatos - a chamada fica muda.
  # node_ip estatico: candidato IPv4 valido, funciona via forward no roteador
  # (UDP 50000-50100 + TCP 7881 -> celular). A supervisao do start-all.sh
  # reinicia o LiveKit se ele morrer no boot (netlink EINVAL, flaky).
  use_external_ip: false
  node_ip: <public-ipv4>
  port_range_start: 50000
  port_range_end: 50100
  tcp_port: 7881

redis:
  address: 127.0.0.1:6379

turn:
  enabled: false

keys:
  <node-key>: <node-secret>

webhook:
  api_key: <node-key>
  urls:
  - "http://127.0.0.1:8500/worldwide"
